@inject NavigationManager Nav
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<BlazorIncrementalApp.Data.OrderDbContext> DbFactory
@inject BlazorIncrementalApp.Data.UsePersonalDetails UserData
@rendermode InteractiveServer
@page "/Login"

<style>
    body {
        background: #fff;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }
</style>

<div class="LoginScreen">
    <h1 class="LoginTitle">Login or Sign Up</h1>
    <input type="text" @bind="username" class="Username" placeholder="Username">
    <input type="email" @bind="email" class="Email" placeholder="Email">
    <input type="password" @bind="password" class="Password" placeholder="Password">

    @if (string.IsNullOrEmpty(username))
    {
        <p class="ErrorMessage">@errorMessage</p>
    }

    <button @onclick="Submit" class="SubmitButton">Submit</button>
</div>

@code {
    private string username;
    private string email;
    private string password;
    private string errorMessage;
    private static readonly Random _rand = new Random();
    private int rnd = _rand.Next(10000, 99999);

    private async Task Submit()
    {
        if (string.IsNullOrEmpty(username))
        {
            errorMessage = "You must enter a username";
            return;
        }
        if (string.IsNullOrEmpty(email))
        {
            errorMessage = "You must enter an email";
            return;
        }
        if (string.IsNullOrEmpty(password))
        {
            errorMessage = "You must enter a password";
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();

        var details = new PersonalDetails
        {
            //PlayerID = playerId,
            Username = username,
            Email = email,
            Password = password
        };

        db.PersonalDetails.Add(details);
        await db.SaveChangesAsync();

        UserData.PlayerID = details.PlayerID;
        UserData.Username = details.Username;
        UserData.Email = details.Email;
        UserData.Password = details.Password;

        Nav.NavigateTo("/");
    }
}
