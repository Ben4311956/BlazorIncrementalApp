@page "/"  
@rendermode InteractiveServer
@inject Points State
@inject Buttons BState
<MainHeader/>

<PageTitle>Home</PageTitle>  

<div class="StarterBtns">
    <button class="sb" type="button" @onclick="PointCounter">Lower Point Gain Button</button>
    @if (BState.MidPointBtnUnlocked)
    {
        <button class="sb2" type="button" @onclick="PointCounter2">Middle Point Gain Button</button>
    }
</div>

<div class="UpgradesBar">
    <h2>Upgrades Bar</h2>
    <div>
        <h3>Upgrades: @(State.Upgrades - 1) </h3>
        <button class="ub" type="button" @onclick="UpgradeBtn1">Lower Upgrade: @(State.Upgrades * 50)</button>
    </div>
    @if (State.Upgrade2Unlocked)
    {
        <h3>Upgrades: @(State.Upgrade2 - 1)</h3>
        <button class="ub" type="button" @onclick="UpgradeBtn2">Mid Upgrade: @(State.Upgrade2 * 500)</button>
    }
</div>
@code  
{
    private bool _disposed;

    protected override void OnInitialized()
    {
        BState.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(() =>
            {
                if (!_disposed)
                    StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        _disposed = true;
        BState.OnChange -= OnStateChanged;
    }

    private void PointCounter()  
    {
        State.Point += State.PointMulti;
        CheckUnlocked();
    }
    private void PointCounter2()
    {
        State.Point += State.PointMulti * 2;
    }
    private void UpgradeBtn1()
    {
        int price = State.Upgrades * 50;
        if (State.Point >= price)
        {
            State.Point -= price;
            State.Upgrades++;
        }
    }
    private void UpgradeBtn2()
    {
        int price = State.Upgrade2 * 500;
        if (State.Point >= price)
        {
            State.Point -= price;
            State.Upgrade2++;
        }
    }
    private void CheckUnlocked()
    {
        if (State.Point >= 10000)
        {
            BState.MidPointBtnUnlocked = true;
        }
        if (State.Point >= 500)
        {
            State.Upgrade2Unlocked = true;
        }
    }
}