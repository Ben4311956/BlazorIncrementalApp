@page "/"  
@rendermode InteractiveServer
@inject Points State
@inject Buttons BState

<style>
    body {
        background: linear-gradient(120deg, #20bfff, #265fec, #652df0);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }
</style>

<MainHeader PageName="Home"/>

<PageTitle>Home</PageTitle>  

<div class="StarterBtns">
    <button class="sb" type="button" @onclick="PointCounter">Lower Point Gain Button</button>
    @if (BState.MidPointBtnUnlocked)
    {
        <button class="sb2" type="button" @onclick="PointCounter2">Middle Point Gain Button</button>
    }
    @if (BState.HighPointBtnUnlocked)
    {
        <button class="sb3" type="button" @onclick="PointCounter3">Higher Point Gain Button</button>
    }
</div>

<button class="pb" type="button" @onclick="Prestige">Prestige?</button>

<div class="UpgradesBar">
    <h1 class="UpgBarTitle">Upgrades Bar</h1>
    <div class="FirstUpgradeButton">
        <h3 class="UpgradesText">Upgrades: @(State.Upgrades - 1) </h3>
        <button class="ub" type="button" @onclick="UpgradeBtn1">Lower Upgrade: @(State.Upgrades * 50)</button>
    </div>
    @if (State.Upgrade2Unlocked)
    {
        <h3 class="UpgradesText">Upgrades: @(State.Upgrade2 - 1)</h3>
        <button class="ub" type="button" @onclick="UpgradeBtn2">Middle Upgrade: @(State.Upgrade2 * 500)</button>
    }
    @if (State.Upgrade3Unlocked)
    {
        <h3 class="UpgradesText">Upgrades: @(State.Upgrade3 - 1)</h3>
        <button class="ub" type="button" @onclick="UpgradeBtn3">Higher Upgrade: @(State.Upgrade3 * 25000)</button>
    }
    @if (State.Upgrade4Unlocked)
    {
        <h3 class="UpgradesText">Upgrades: @(State.Upgrade4 - 1)</h3>
        <button class="ub" type="button" @onclick="UpgradeBtn4">Supreme Upgrade: @(State.Upgrade4 * 1000000)</button>
    }
    <pre>






    



                                                                                                                                                            .
    </pre>
</div>

<div class="Shop">
    <h1 class="ShopTitle">Shop</h1>
    <h3 class="ProductTitle">CRITICAL GAIN: @(State.CriticalGainAmount)</h3>
    <p class="ShopDescriptions">OtherWorldly ability designed to enhance point gain. </p>
    <p class="ShopDescriptions">Chance: @State.CriticalGainChance %   Critical Boost: @State.CriticalBoost %</p>
    <button class="@ButtonClass" @onclick="CriticalGain">Critical Gain: @Points.FormatNumbers(CriticalGainPrice)</button>
    <h3 class="ProductTitle">EXREME OVERDOSE: @(State.OverdoseAmount)</h3>
    <p class="ShopDescriptions">Point production explodes giving 3x more point gain (@(State.OverdoseAmount) Owned)</p>
    <button class="@ButtonClass2" @onclick="Overdose">Extreme Overdose: @Points.FormatNumbers(OverdoseGainPrice)</button>
    <h3 class="ProductTitle">AUTO CLICKER: @AutoClickerOwned</h3>
    <p class="ShopDescriptions">Ever get tired of clicking? don't worry, this one will click for you!</p>
    <button class="@ButtonClass3" @onclick="AutoClicker">Auto Clicker: @Points.FormatNumbers(AutoClickerGainPrice) @State.AutoClickerUpgrades</button>

</div>

@code  
{
    private bool AutoClickerRunning = false;
    private string AutoClickerOwned => BState.AutoClickerUnlocked ? "(Owned)" : "(Unowned)";
    private decimal AutoClickerGainPrice => BState.AutoClickerUnlocked ? (1000000000000m * (decimal)Math.Pow(2, (double)State.AutoClickerUpgrades)) : 1000000000000m;
    private decimal OverdoseGainPrice => State.OverdoseUnlocked ? (2000000000m * (decimal)Math.Pow(10, (double)State.OverdoseAmount)) : 2000000000m;
    private decimal CriticalGainPrice => BState.CriticalGainUnlocked ? (1000000000m * (decimal)Math.Pow(2, (double)State.CriticalGainAmount)) : 1000000000m;
    private string ButtonClass => BState.CriticalGainUnlocked ? "CriticalGainUnlocked" : "CriticalGainLocked";
    private string ButtonClass2 => State.OverdoseUnlocked ? "OverdoseUnlocked" : "OverdoseLocked";
    private string ButtonClass3 => BState.AutoClickerUnlocked ? "AutoClickerUnlocked" : "AutoClickerLocked";
    private bool _disposed;

    protected override void OnInitialized()
    {
        BState.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(() =>
            {
                if (!_disposed)
                    StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        _disposed = true;
        BState.OnChange -= OnStateChanged;
    }
    private void CriticalGain()  
    {
        decimal BaseCost = 1000000000m;
        decimal criticalGainValue = BaseCost * (decimal)Math.Pow(2, (double)State.CriticalGainAmount);

        if (!BState.CriticalGainUnlocked && State.Point >= BaseCost)
        {
            State.Point -= BaseCost;
            BState.CriticalGainUnlocked = true;
            State.CriticalGainAmount++;
            State.CriticalBoost += 0.01;
            State.CriticalGainChance += 0.01;

        }
        else if (State.Point >= criticalGainValue && BState.CriticalGainUnlocked)  
        {  
            State.Point -= criticalGainValue;  
            State.CriticalGainAmount++;
            State.CriticalBoost += 0.01;
            State.CriticalGainChance += 0.01;
        }
    }  
    private void PointCounter()  
    {
        if (State.CriticalGainChance > 0)
        {
            Random rnd = new Random();
            int num = rnd.Next(0, 101);
            if (((State.CriticalGainChance * 100) - 100) >= num)
            {
                State.Point += State.PointMulti * (decimal)State.CriticalBoost;
            }
            else
            {
                State.Point += State.PointMulti;
            }
            CheckUnlocked();
        }
        else
        {
            State.Point += State.PointMulti;
            CheckUnlocked();
        }
    }
    private void PointCounter2()
    {
        if (State.CriticalGainChance > 0)
        {
            Random rnd = new Random();
            int num = rnd.Next(0, 101);
            if (((State.CriticalGainChance * 100) - 100) >= num)
            {
                State.Point += (State.PointMulti * 2) * (decimal)State.CriticalBoost;
            }
            else
            {
                State.Point += State.PointMulti * 2;
            }
            CheckUnlocked();
        }
        else
        {
            State.Point += State.PointMulti * 2;
            CheckUnlocked();
        }
    }
    private void PointCounter3()
    {
        if (State.CriticalGainChance > 0)
        {
            Random rnd = new Random();
            int num = rnd.Next(0, 101);
            if (((State.CriticalGainChance * 100) - 100) >= num)
            {
                State.Point += (State.PointMulti * 5) * (decimal)State.CriticalBoost;
            }
            else
            {
                State.Point += State.PointMulti * 5;
            }
            CheckUnlocked();
        }
        else
        {
            State.Point += State.PointMulti * 5;
            CheckUnlocked();
        }
    }
    private void UpgradeBtn1()
    {
        decimal price = State.Upgrades * 50;
        if (State.Point >= price)
        {
            State.Point -= price;
            State.Upgrades++;
        }
    }
    private void UpgradeBtn2()
    {
        decimal price = State.Upgrade2 * 500;
        if (State.Point >= price)
        {
            State.Point -= price;
            State.Upgrade2++;
        }
    }
    private void UpgradeBtn3()
    {
        decimal price = State.Upgrade3 * 25000;
        if (State.Point >= price)
        {
            State.Point -= price;
            State.Upgrade3++;
        }
    }
    private void UpgradeBtn4()
    {
        decimal price = State.Upgrade4 * 1000000;
        if (State.Point >= price)
        {
            State.Point -= price;
            State.Upgrade4++;
        }
    }
    private void Prestige()
    {
        if (State.Point >= 1000000000000)
        {
            State.PrestigeUnlocked = true;
            State.Point -= 1000000000000;
            State.Prestige += 1;
        }
    }
    private void CheckUnlocked()
    {
        if (State.Point >= 10000)
        {
            BState.MidPointBtnUnlocked = true;
        }
        if (State.Point >= 1000000)
        {
            BState.HighPointBtnUnlocked = true;
        }
        if (State.Point >= 500)
        {
            State.Upgrade2Unlocked = true;
        }
        if (State.Point >= 25000)
        {
            State.Upgrade3Unlocked = true;
        }
        if(State.Point >= 1000000)
        {
            State.Upgrade4Unlocked = true;
        }
    }
    private void Overdose()
    {
        decimal BaseCost = 2000000000m;
        decimal criticalGainValue = BaseCost * (decimal)Math.Pow(10, (double)State.OverdoseAmount);
        if (State.Point >= BaseCost && !State.OverdoseUnlocked)
        {
            State.Point -= BaseCost;
            State.OverdoseUnlocked = true;
            State.Overdose += 3;
            State.OverdoseAmount++;
        }
        else if (State.OverdoseUnlocked && State.Point >= criticalGainValue)
        {
            State.Point -= criticalGainValue;
            State.Overdose *= 3;
            State.OverdoseAmount++;
        }
    }
    private async Task AutoClicker()
    {
        if (AutoClickerRunning)
        {
            return;
        }

        decimal BaseCost = 1000000000000m;
        decimal criticalGainValue = BaseCost * (decimal)Math.Pow(2, (double)State.AutoClickerUpgrades);

        if (!BState.AutoClickerUnlocked && State.Point >= BaseCost)
        {
            State.Point -= BaseCost;
            BState.AutoClickerUnlocked = true;
            State.AutoClickerUpgrades++;
        }
        else if (BState.AutoClickerUnlocked && State.Point >= criticalGainValue)
        {
            State.Point -= criticalGainValue;
            State.AutoClickerUpgrades++;
        }
        if (BState.AutoClickerUnlocked)
        {
            AutoClickerRunning = true;

            while (AutoClickerRunning)
            {
                State.Point += State.PointMulti;
                StateHasChanged();
                await Task.Delay(State.DelayAmount / Math.Max(State.AutoClickerUpgrades, 1));
            }
        }
    }
}