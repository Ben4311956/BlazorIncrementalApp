@page "/"  
@rendermode InteractiveServer
@inject Points State
<MainHeader/>

<PageTitle>Home</PageTitle>  

<div class="StarterBtns">
    <button class="sb" type="button" @onclick="PointCounter">Gain Points</button>
    <div>
        <h3>Upgrades: @State.Upgrades </h3>
        <button class="ub" type="button" @onclick="UpgradeCounter">Upgrade Button</button>
    </div>
</div>
@code  
{
    private void PointCounter()  
    {
        if (State.Upgrades <= 0)
        {
            State.Point++;
        }  
        else  
        {  
            State.Point += State.PointMulti;  
        }  
    }
    private void UpgradeCounter()
    {
        int price = (State.Upgrades + 1) * 50;
        if (State.Point >= price)
        {
            State.Point -= price;
            State.Upgrades++;
        }
    }
}