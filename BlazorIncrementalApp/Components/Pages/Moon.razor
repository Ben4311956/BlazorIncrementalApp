@page "/Moon"
@inject MoonPoints State
@implements IDisposable

<style>
    body {
        background: #2b2b2b;
    }
</style>
<MainHeader PageName="Moon"/>


@if (State.MoonUnlocked)
{
    <button type="button" class="MoonButton">
        <img class="MoonMain" src="Images/full-moon.png" alt="The Moon" />
    </button>
}
else
{
    <h1 class="Rejection">The Moon Rejects You</h1>
}

@code {
    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }
    public void Dispose()
    {
        State.OnChange += StateHasChanged;
    }
}
