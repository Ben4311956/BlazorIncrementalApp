@page "/Moon"
@inject MoonPoints State
@inject Points PState
@inject NavigationManager Nav
@rendermode InteractiveServer
@implements IDisposable

<style>
    body {
        background: #2b2b2b;
    }
</style>
<MainHeader PageName="Moon"/>

@if (State.MoonUnlocked)
{
    <button type="button" class="MoonButton" @onclick="AddPoint">
        <img class="MoonMain" src="Images/full-moon.png" alt="The Moon" />
    </button>

    @foreach (var effect in effects)
    {
        <div class="floating-effect" style="--offsetX:@(effect.OffsetX); --offsetY:@(effect.OffsetY)">+@(MoonPoints.FormatNumbers(State.MoonPointMultiplier))</div>
    }

    <div class="PlanetContainer">
        <button type="button" class="VenusButton @(State.VenusUnlocked ? "unlocked" : "locked")" 
            disabled="@(State.VenusUnlocked || PState.Prestige >= 500 ? false : true)"
            @onclick="MoveToVenus">
            <img class="Venus" src="Images/venus.png" alt="Venus"/> 
            @if (!State.VenusUnlocked)
            {
                <span class="VenusLockedText">500 Prestiges</span>
            }
        </button>
    </div>
}
else
{
    <h1 class="Rejection">The Moon Rejects You</h1>
}

@code {
    private List<FloatingEffect> effects = new();
    private int counter = 0;
    private Random rand = new();

    private async Task AddPoint()
    {
        var id = counter++;
        effects.Add(new FloatingEffect { Id = id, OffsetX = rand.Next(-135,136), OffsetY = rand.Next(-135, 136) });
        StateHasChanged();

        await Task.Delay(1200);
        effects.RemoveAll(e => e.Id == id);
        StateHasChanged();
    }



    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }
    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }

    private class FloatingEffect
    {
        public int Id { get; set; }
        public int OffsetX { get; set; }
        public int OffsetY { get; set; }
    }

    private void MoveToVenus()
    {
        if (!State.VenusUnlocked && PState.Prestige >= 500)
        {
            State.VenusUnlocked = true;
            Nav.NavigateTo("/Venus");
        }
        else if (State.VenusUnlocked)
        {
            Nav.NavigateTo("/Venus");
        }
    }

}
