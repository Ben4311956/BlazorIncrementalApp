@inject Points State
@inject MoonPoints MState
@inject NavigationManager NavigationManager

<nav class="top-nav" style="background:@HeaderColor;">
    @if (PageName == "Home")
    {
        <span>Points: @Points.FormatNumbers(State.Point)</span>
    }
    @if (PageName == "Moon")
    {
        <span>Moon Points: @MState.MoonPoint</span>
    }
    @if (PageName == "Venus")
    {
        <span>Moon Points: @MState.MoonPoint</span>
    }
    <a href="/">Home</a>
    @if (State.PrestigeUnlocked)
    {
        <a href="/Moon">Moon</a>
        <span>Prestiges: @State.Prestige</span>
    }
    <a href="/Venus">venus</a>
</nav>

@code {
    private string HeaderColor = "#000000";
    [Parameter]
    public string PageName { get; set; } = "Default Page";
    private bool _disposed;

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
        MState.OnChange += OnStateChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateColor(NavigationManager.Uri);
    }

    private void OnStateChanged()
    {
        if(!_disposed)
        {
            _ = InvokeAsync(() =>
            {
                if (!_disposed)
                    StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        _disposed = true;
        State.OnChange -= OnStateChanged;
        MState.OnChange -= OnStateChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;

    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateColor(e.Location);
        StateHasChanged();
    }

    private void UpdateColor(string uri)
    {
        if (uri.EndsWith("/"))
        {
            HeaderColor = "#1a237e";
        }
        if (uri.EndsWith("/Moon"))
        {
            HeaderColor = "#8a8a8a";
        }
        if (uri.EndsWith("/Venus"))
        {
            HeaderColor = "#cc5f1b";
        }
    }
}
