@inject Points State

<nav class="top-nav">
    <span>Points: @State.Point</span>
    <a href="/">Home</a>
    <a href="/vlads-dungeon">Vlad's Dungeon</a>
</nav>

@code {
    private bool _disposed;

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        if(!_disposed)
        {
            _ = InvokeAsync(() =>
            {
                if (!_disposed)
                    StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        _disposed = true;
        State.OnChange -= OnStateChanged;
    }
}
