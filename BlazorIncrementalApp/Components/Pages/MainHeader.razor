@inject Points State
@inject MoonPoints MState

<nav class="top-nav">
    @if (PageName == "Home")
    {
        <span>Points: @Points.FormatNumbers(State.Point)</span>
    }
    @if (PageName == "Moon")
    {
        <span>Moon Points: @MState.MoonPoint</span>
    }
    <a href="/">Home</a>
    @if (State.PrestigeUnlocked)
    {
        <a href="/Moon">Moon</a>
        <span>Prestiges: @State.Prestige</span>
    }
</nav>

@code {
    [Parameter]
    public string PageName { get; set; } = "Default Page";
    private bool _disposed;

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        if(!_disposed)
        {
            _ = InvokeAsync(() =>
            {
                if (!_disposed)
                    StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        _disposed = true;
        State.OnChange -= OnStateChanged;
    }
}
